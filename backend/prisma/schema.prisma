generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String?                    @unique
  name              String
  password          String
  role              Role
  department        String?
  classGroup        String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  semesterId        String?                    @db.Uuid
  backlogSubjects   String[]                   @default([])
  numberOfBacklogs  Int                        @default(0)
  program           String?
  batchEndYear      Int?
  batchStartYear    Int?
  isActive          Boolean                    @default(true)
  adminUploads      AdminUpload[]              @relation("AdminUploads")
  announcements     Announcement[]             @relation("UserAnnouncements")
  attendanceRecords AttendanceRecord[]
  marks             Mark[]
  notes             Note[]
  enrollments       StudentEnrollment[]
  labAssignments    SubjectSectionAssignment[] @relation("LabAssignments")
  theoryAssignments SubjectSectionAssignment[] @relation("TheoryAssignments")
  semester          Semester?                  @relation(fields: [semesterId], references: [id])

  @@index([classGroup])
  @@index([role])
  @@index([role, classGroup])
  @@index([role, program])
}

model Subject {
  code        String                     @id
  name        String
  type        SubjectType                @default(STANDALONE)
  courseType  SubjectCourseType          @default(NEEDS_CONFIGURATION)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  id          String                     @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description String?
  assignments SubjectSectionAssignment[] @relation("SubjectAssignments")
}

model SubjectSectionAssignment {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId          String              @db.Uuid
  theoryFacultyId    String?             @db.Uuid
  labFacultyId       String?             @db.Uuid
  classGroup         String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attendanceSessions AttendanceSession[] @relation("AttendanceSessionAssignment")
  marks              Mark[]              @relation("MarkAssignment")
  labFaculty         User?               @relation("LabAssignments", fields: [labFacultyId], references: [id])
  subject            Subject             @relation("SubjectAssignments", fields: [subjectId], references: [id])
  theoryFaculty      User?               @relation("TheoryAssignments", fields: [theoryFacultyId], references: [id])
  timetableSlots     TimetableSlot[]     @relation("TimetableSlotAssignment")

  @@unique([subjectId, classGroup])
  @@index([labFacultyId])
  @@index([subjectId])
  @@index([theoryFacultyId])
}

model Semester {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String              @unique
  name               String
  startDate          String?
  endDate            String?
  status             SemesterStatus
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attendanceSessions AttendanceSession[]
  marks              Mark[]
  enrollments        StudentEnrollment[]
  timetableSlots     TimetableSlot[]
  students           User[]

  @@index([status])
}

model StudentEnrollment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String   @db.Uuid
  semesterId     String   @db.Uuid
  semesterNumber Int
  program        String
  classGroup     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  semester       Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, semesterId])
  @@index([semesterId, semesterNumber])
  @@index([semesterId, program])
  @@index([semesterId, classGroup])
  @@index([studentId])
}

model AttendanceSession {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date         String
  classGroup   String
  semesterId   String                    @db.Uuid
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime
  endTime      String
  room         String?
  startTime    String
  assignmentId String?                   @db.Uuid
  records      AttendanceRecord[]
  assignment   SubjectSectionAssignment? @relation("AttendanceSessionAssignment", fields: [assignmentId], references: [id], onUpdate: NoAction)
  semester     Semester                  @relation(fields: [semesterId], references: [id])

  @@unique([assignmentId, date, classGroup, semesterId, startTime, endTime])
  @@index([date, semesterId])
  @@index([assignmentId])
}

model AttendanceRecord {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String            @db.Uuid
  studentId String            @db.Uuid
  status    String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model Mark {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String                    @db.Uuid
  type             String
  score            Float?
  maxScore         Float
  semesterId       String                    @db.Uuid
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  assign1Submitted Boolean                   @default(false)
  assign2Submitted Boolean                   @default(false)
  assignmentId     String?                   @db.Uuid
  assignment       SubjectSectionAssignment? @relation("MarkAssignment", fields: [assignmentId], references: [id], onUpdate: NoAction)
  semester         Semester                  @relation(fields: [semesterId], references: [id])
  student          User                      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assignmentId, type, semesterId])
  @@index([studentId, semesterId])
  @@index([assignmentId])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  category  String
  date      String
  authorId  String   @db.Uuid
  target    String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation("UserAnnouncements", fields: [authorId], references: [id])
}

model TimetableSlot {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day          String
  slotIndex    Int
  room         String?
  classGroup   String
  subjectCode  String?
  teacherId    String
  semesterId   String                    @db.Uuid
  batchYear    Int?                     // batch year of students
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  coTeacherId  String?
  assignmentId String?                   @db.Uuid
  activityType String? // Added activityType field
  assignment   SubjectSectionAssignment? @relation("TimetableSlotAssignment", fields: [assignmentId], references: [id], onUpdate: NoAction)
  semester     Semester                  @relation(fields: [semesterId], references: [id])

  @@unique([classGroup, day, slotIndex, semesterId, batchYear])
  @@index([teacherId, semesterId])
  @@index([classGroup, semesterId])
  @@index([coTeacherId])
  @@index([assignmentId])
  @@index([batchYear])
}

model Note {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?
  fileName     String
  filePath     String
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

model AdminUpload {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?
  fileName     String
  filePath     String
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  uploadedBy   User     @relation("AdminUploads", fields: [uploadedById], references: [id], onDelete: Cascade)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model SubjectOld {
  code        String?
  name        String?
  facultyId   String?
  classGroup  String?
  type        SubjectType?
  createdAt   DateTime?
  updatedAt   DateTime?
  coFacultyId String?

  @@map("_SubjectOld")
  @@ignore
}

enum Role {
  student
  teacher
  dean
  principal
  hod
}

enum SemesterStatus {
  ACTIVE
  UPCOMING
  ARCHIVED
}

enum SubjectType {
  STANDALONE
  INTEGRATED
}

enum SubjectCourseType {
  NEEDS_CONFIGURATION
  STANDALONE
  INTEGRATED
  PROJECT
}
